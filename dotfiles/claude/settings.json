{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "editorMode": "vim",
  "effortLevel": "xhigh",
  "enabledPlugins": {
    "analysis-tools@fossa-claude-skills": true,
    "clangd-lsp@claude-plugins-official": true,
    "general@nficca-plugins": true,
    "gopls-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "slack@claude-plugins-official": true,
    "sre-tools@fossa-claude-skills": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "fossa-claude-skills": {
      "source": {
        "repo": "fossas/claude-skills",
        "source": "github"
      }
    },
    "nficca-plugins": {
      "autoUpdate": true,
      "source": {
        "repo": "nficca/claude-plugin",
        "source": "github"
      }
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash '/home/nic/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ]
  },
  "statusLine": {
    "command": "~/.claude/statusline.sh",
    "refreshInterval": 10,
    "type": "command"
  },
  "tui": "fullscreen"
}